# Copy to .env and fill in. The OJA server (server/app/shared/env.py) requires every
# key in the sections below the prototype block; a missing key stops it at startup.

# --- backend.py prototype only (not read by the OJA server) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OJA_MODEL=gpt-4o-mini

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/oja
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- LLM: any OpenAI-compatible chat completions endpoint ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=15
LLM_MAX_TOKENS=400

# --- Speech-to-text: OpenAI-compatible transcription (local whisper.cpp server shown) ---
STT_BASE_URL=http://127.0.0.1:8080
STT_INFERENCE_PATH=/v1/audio/transcriptions
STT_API_KEY=
STT_MODEL=whisper-1
STT_TIMEOUT_SECONDS=30
STT_MAX_UPLOAD_MB=15

# --- Ledger: below this confidence a complete entry is confirmed before saving ---
CONFIDENCE_THRESHOLD=0.7
# A new name the model matches to an existing customer: link (and save as alias) at or above LINK,
# ask "Do you mean ...?" at or above CONFIRM, otherwise create a new customer.
CUSTOMER_MATCH_LINK_CONFIDENCE=0.85
CUSTOMER_MATCH_CONFIRM_CONFIDENCE=0.5

# --- Restock suggestions: ranking weights, distance at which the distance score halves, grade scores ---
SUGGESTION_WEIGHT_DISTANCE=0.25
SUGGESTION_WEIGHT_RATING=0.2
SUGGESTION_WEIGHT_QUALITY=0.15
SUGGESTION_WEIGHT_COST=0.25
SUGGESTION_WEIGHT_QUANTITY=0.15
SUGGESTION_DISTANCE_HALF_KM=10
SUGGESTION_QUALITY_SCORE_A=1.0
SUGGESTION_QUALITY_SCORE_B=0.7
SUGGESTION_QUALITY_SCORE_C=0.4

# --- Demo and access control ---
# true = no provider calls, rule-based interpretation only (offline demo).
DEMO_MODE=false
# true enables POST /demo/reset and /demo/seed. Never on a shared deployment.
DEMO_CONTROLS_ENABLED=false
# Trader session lifetime in days.
SESSION_TOKEN_TTL_DAYS=30
# Lender agent token lifetime in minutes (43200 = 30 days; shorten for the demo).
ACCESS_TOKEN_TTL_MINUTES=43200
# JSON list of browser origins allowed to call the API, e.g. ["http://localhost:3000"]
CORS_ORIGINS=[]
