OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# OJA server (server/app/shared/env.py)
OJA_MODEL=gpt-5-nano
OJA_STT_MODEL=whisper-1
LLM_TIMEOUT_SECONDS=15
# PostgreSQL, or SQLite for a laptop demo: sqlite:///./oja.sqlite3
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/oja
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# true = no provider calls, rule-based extraction only (offline demo).
DEMO_MODE=false
# true enables POST /demo/reset and /demo/seed. Never on a shared deployment.
DEMO_CONTROLS_ENABLED=false
SESSION_TOKEN_TTL_DAYS=30
# Lender agent token lifetime. 43200 = 30 days; shorten for the demo.
ACCESS_TOKEN_TTL_MINUTES=43200
# JSON list of allowed browser origins, e.g. ["http://localhost:3000"]
CORS_ORIGINS=[]
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=15
LLM_MAX_TOKENS=400

STT_BASE_URL=http://127.0.0.1:8080
STT_INFERENCE_PATH=/v1/audio/transcriptions
STT_API_KEY=
STT_MODEL=whisper-1
STT_TIMEOUT_SECONDS=30
STT_MAX_UPLOAD_MB=15

CONFIDENCE_THRESHOLD=0.7

SUGGESTION_WEIGHT_DISTANCE=0.25
SUGGESTION_WEIGHT_RATING=0.2
SUGGESTION_WEIGHT_QUALITY=0.15
SUGGESTION_WEIGHT_COST=0.25
SUGGESTION_WEIGHT_QUANTITY=0.15
SUGGESTION_DISTANCE_HALF_KM=10
SUGGESTION_QUALITY_SCORE_A=1.0
SUGGESTION_QUALITY_SCORE_B=0.7
SUGGESTION_QUALITY_SCORE_C=0.4
